---
import "swiper/css/bundle";
---

<div class="swiper mySwiper w-full max-w-5xl">
  <div class="swiper-wrapper">
    <!-- image 1 -->
    <div class="swiper-slide relative group rounded-lg overflow-hidden">
      <img
        src="/assets/hero-iglesia.jpg"
        alt="Evento 1"
        class="rounded-lg w-full h-64 md:h-80 lg:h-96 object-cover"
      />
      <div
        class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-sky-950/80 to-transparent text-white px-4 py-3 opacity-0 group-hover:opacity-100 transform translate-y-4 group-hover:translate-y-0 transition-all duration-500"
      >
        <h3 class="text-lg font-semibold">Campamento Juvenil 2024</h3>
        <p class="text-sm">
          Un tiempo inolvidable de comunión y crecimiento espiritual.
        </p>
      </div>
    </div>

    <!-- image 2 -->
    <div class="swiper-slide relative group rounded-lg overflow-hidden">
      <img
        src="/assets/hero2.jpg"
        alt="Evento 2"
        class="rounded-lg w-full h-64 md:h-80 lg:h-96 object-cover"
      />
      <div
        class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-sky-950/80 to-transparent text-white px-4 py-3 opacity-0 group-hover:opacity-100 transform translate-y-4 group-hover:translate-y-0 transition-all duration-500"
      >
        <h3 class="text-lg font-semibold">Día Juvenil 2024</h3>
        <p class="text-sm">
          Un tiempo inolvidable de comunión y crecimiento espiritual.
        </p>
      </div>
    </div>

    <!-- image 3 -->
    <div class="swiper-slide relative group rounded-lg overflow-hidden">
      <img
        src="/assets/diaFamiliar.jpg"
        alt="Evento 3"
        class="rounded-lg w-full h-64 md:h-80 lg:h-96 object-cover"
      />
      <div
        class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-sky-950/80 to-transparent text-white px-4 py-3 opacity-0 group-hover:opacity-100 transform translate-y-4 group-hover:translate-y-0 transition-all duration-500"
      >
        <h3 class="text-lg font-semibold">Integración Familiar</h3>
        <p class="text-sm">
          Un tiempo inolvidable de comunión y crecimiento espiritual.
        </p>
      </div>
    </div>

    <!-- image 4 -->
    <div class="swiper-slide relative group rounded-lg overflow-hidden">
      <img
        src="/assets/hero1.jpg"
        alt="Evento 4"
        class="rounded-lg w-full h-64 md:h-80 lg:h-96 object-cover"
      />
      <div
        class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-sky-950/80 to-transparent text-white px-4 py-3 opacity-0 group-hover:opacity-100 transform translate-y-4 group-hover:translate-y-0 transition-all duration-500"
      >
        <h3 class="text-lg font-semibold">Confraternidad 2024</h3>
        <p class="text-sm">
          Un tiempo inolvidable de comunión y crecimiento espiritual.
        </p>
      </div>
    </div>
  </div>

  <!-- Controles -->
  <div class="swiper-pagination"></div>
  <div class="swiper-button-prev"></div>
  <div class="swiper-button-next"></div>
</div>
