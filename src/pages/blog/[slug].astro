---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { slug } = Astro.params;
const posts = await getCollection("blog");
const post = posts.find((p) => p.slug === slug);

if (!post) throw new Error(`Artículo no encontrado: ${slug}`);

const { Content } = await post.render(); // ✅ solo esto
const { title, date, image, description } = post.data; // ✅ y esto por separado
---

<BaseLayout title={`${title} - Blog`} description={description}>
  <article class="max-w-3xl mx-auto px-4 py-20 text-gray-800">
    {
      image && (
        <img
          src={image}
          alt={title}
          class="rounded-lg mb-10 w-full object-cover h-64 md:h-96 shadow-lg"
        />
      )
    }
    <h1 class="text-4xl md:text-5xl font-bold text-gray-700 mb-4">{title}</h1>
    <p class="text-gray-500 mb-8 italic">
      Publicado el {new Date(date).toLocaleDateString("es-ES")}
    </p>

    <div class="prose lg:prose-lg max-w-none prose-blue">
      <Content />
    </div>
  </article>
</BaseLayout>
