---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contacto - Iglesia Bautista Reformada"
  description="Contáctanos para más información sobre nuestros cultos y actividades."
>
  <section class="py-20 bg-white text-center">
    <h1 class="text-4xl md:text-6xl font-bold text-blue-900 mb-6">
      Contáctanos
    </h1>
    <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-10">
      Estamos aquí para servirte. Si tienes preguntas, peticiones de oración o
      deseas conocer más sobre nuestra iglesia, no dudes en escribirnos.
    </p>

    <!-- Información de contacto -->
    <div class="max-w-4xl mx-auto grid md:grid-cols-3 gap-8 text-left mb-10">
      <div>
        <h3 class="text-xl font-semibold text-blue-800 mb-2">📍 Dirección</h3>
        <p class="text-gray-700">Calle Ejemplo 123<br />28981 Parla, Madrid</p>
      </div>
      <div>
        <h3 class="text-xl font-semibold text-blue-800 mb-2">📞 Teléfono</h3>
        <p class="text-gray-700">+34 600 123 456</p>
      </div>
      <div>
        <h3 class="text-xl font-semibold text-blue-800 mb-2">
          ⏰ Horario de Atención
        </h3>
        <p class="text-gray-700">
          Lunes a Viernes <br />10:00 - 14:00 y 17:00 - 20:00
        </p>
      </div>
    </div>

    <!-- Formulario de contacto -->
    <form
      action="https://formsubmit.co/servidorfiel42@gmail.com"
      method="POST"
      class="max-w-2xl mx-auto bg-gray-50 p-8 rounded-lg shadow-md text-left"
    >
      <div class="mb-4">
        <label
          class="block text-sm font-semibold text-gray-700 mb-1"
          for="nombre">Nombre</label
        >
        <input
          type="text"
          id="nombre"
          name="nombre"
          required
          class="w-full border rounded px-3 py-2 bg-white border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <div class="mb-4">
        <label
          class="block text-sm font-semibold text-gray-700 mb-1"
          for="email">Correo electrónico</label
        >
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full border rounded px-3 py-2 bg-white border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <div class="mb-6">
        <label
          class="block text-sm font-semibold text-gray-700 mb-1"
          for="mensaje">Mensaje</label
        >
        <textarea
          id="mensaje"
          name="mensaje"
          rows="5"
          required
          class="w-full border rounded px-3 py-2 bg-white border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
        ></textarea>
      </div>

      <!-- campos ocultos -->
      <!-- remplazar la ruta cuando este el dominio -->
      <input
        type="hidden"
        name="_next"
        value="https://iglesia-bautista-parla.vercel.app/gracias"
      />
      <input type="hidden" name="_captcha" value="false" />

      <button type="submit" class="boton-principal"> Enviar mensaje </button>
    </form>
  </section>
</BaseLayout>
