---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Reuniones - Iglesia Bautista Reformada"
  description="Horarios de nuestros cultos, estudios bíblicos y reuniones de oración."
>
  <!-- Sección: Hero de Reuniones -->
  <section class="text-center py-20 bg-white">
    <h1
      class="text-4xl md:text-6xl font-bold text-blue-900 mb-6 fade-in delay-0"
    >
      Nuestras Reuniones
    </h1>
    <p
      class="text-lg md:text-2xl text-gray-600 max-w-3xl mx-auto fade-in delay-1"
    >
      Te invitamos a crecer en la fe y a adorar a nuestro Señor Jesucristo en
      comunidad.
    </p>
  </section>

  <!-- Onda divisoria -->
  <div class="wave-divider rotate-180">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
    >
      <path
        d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,
      82.39-16.72,168.19-17.73,250.45-.39,
      80.94,17.34,163.83,58.32,242.82,79.15,
      70.05,18.48,146.53,26.09,214.34,3V0H0V27.35
      A600.21,600.21,0,0,0,321.39,56.44Z"
        class="fill-gray-50"></path>
    </svg>
  </div>

  <!-- Sección: Horarios -->
  <section class="py-20 bg-gray-50">
    <div
      class="max-w-5xl mx-auto px-4 text-center grid gap-12 md:grid-cols-3 fade-in delay-0"
    >
      <div
        class="bg-white rounded-lg shadow-lg p-8 transform transition-transform duration-300 hover:scale-105"
      >
        <h3 class="text-2xl font-semibold text-blue-800 mb-2">
          Culto Dominical
        </h3>
        <p class="text-gray-700 text-xl">Domingos 11:00 AM</p>
        <p>
          Lorem ipsum dolor sit, amet consectetur adipisicing elit. At,
          veritatis.
        </p>
      </div>

      <div
        class="bg-white rounded-lg shadow-lg p-8 transform transition-transform duration-300 hover:scale-105"
      >
        <h3 class="text-2xl font-semibold text-blue-800 mb-2">
          Estudio Biblico
        </h3>
        <p class="text-gray-700 text-xl">Jueves 7:00 PM</p>
        <p>
          Lorem ipsum dolor sit, amet consectetur adipisicing elit. At,
          veritatis.
        </p>
      </div>

      <div
        class="bg-white rounded-lg shadow-lg p-8 transform transition-transform duration-300 hover:scale-105"
      >
        <h3 class="text-2xl font-semibold text-blue-800 mb-2">Reuniones</h3>
        <p class="text-gray-700 text-xl">Sabado 11:00 AM</p>
        <p>
          Lorem ipsum dolor sit, amet consectetur adipisicing elit. At,
          veritatis.
        </p>
      </div>
    </div>
  </section>

  <!-- Onda divisoria -->
  <div class="wave-divider">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
    >
      <path
        d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,
      82.39-16.72,168.19-17.73,250.45-.39,
      80.94,17.34,163.83,58.32,242.82,79.15,
      70.05,18.48,146.53,26.09,214.34,3V0H0V27.35
      A600.21,600.21,0,0,0,321.39,56.44Z"
        class="fill-gray-50"></path>
    </svg>
  </div>

  <!-- Sección: Mapa de Ubicación -->
  <section class="py-20 bg-white text-center">
    <h2 class="text-3xl font-semibold text-blue-900 mb-8 fade-in delay-0 show">
      ¿Dónde nos reunimos?
    </h2>
    <div
      class="max-w-4xl mx-auto px-4 fade-in delay-1 show shadow-md border border-gray-200"
    >
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6091.794137453827!2d-3.7669867251647786!3d40.23359076676733!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd41f538a33ad9bb%3A0x562e8fd3818f12!2sIglesia%20Bautista%20de%20Parla!5e0!3m2!1ses!2ses!4v1745790607544!5m2!1ses!2ses"
        width="100%"
        height="400"
        class="rounded-lg shadow-lg border-0"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>

  <!-- Onda divisoria invertida -->
  <div class="wave-divider rotate-180">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
    >
      <path
        d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,
      82.39-16.72,168.19-17.73,250.45-.39,
      80.94,17.34,163.83,58.32,242.82,79.15,
      70.05,18.48,146.53,26.09,214.34,3V0H0V27.35
      A600.21,600.21,0,0,0,321.39,56.44Z"
        class="fill-gray-50"></path>
    </svg>
  </div>

  <!-- Sección: Invitación final -->
  <div class="py-20 bg-gray-50 text-center">
    <h2 class="text-3xl font-semibold text-blue-900 mb-6 fade-in delay-0">
      ¡Te esperamos!
    </h2>
    <p class="text-gray-700 text-lg mb-8 fade-in delay-1">
      No importa de dónde vengas, nuestras puertas están abiertas para ti.
    </p>
    <div class="mt-8 text-center fade-in delay-2 show">
      <a
        href="https://www.google.com/maps?q=40.2335867,-3.7644118"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-blue-800 text-white px-6 py-3 rounded hover:bg-blue-700 transition-all"
      >
        📍 Cómo llegar
      </a>
    </div>
  </div>
</BaseLayout>
