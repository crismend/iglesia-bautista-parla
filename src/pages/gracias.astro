---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Gracias por tu mensaje"
  description="Hemos recibido tu mensaje correctamente."
>
  <section
    class="min-h-screen flex items-center justify-center bg-white text-center px-4 py-20"
  >
    <div class="max-w-xl fade-in delay-0">
      <img
        src="assets/thankyou.svg"
        alt="Mensaje enviado"
        class="w-48 mx-auto mb-8"
      />

      <h1 class="text-4xl md:text-5xl font-bold text-blue-900 mb-4">
        ¡Gracias por contactarnos!
      </h1>
      <p class="text-lg text-gray-600 mb-8 fade-in delay-1">
        Hemos recibido tu mensaje y nos pondremos en contacto contigo lo antes
        posible.
      </p>

      <a
        href="/"
        class="inline-block bg-blue-800 text-white px-6 py-3 rounded hover:bg-blue-700 transition-all fade-in delay-2"
      >
        Volver al inicio
      </a>
    </div>
  </section>
</BaseLayout>
