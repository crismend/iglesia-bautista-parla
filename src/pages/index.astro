---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Inicio - Iglesia Bautista Reformada"
  description="Bienvenido a nuestra comunidad cristiana en fe reformada."
>
  <section
    class="relative flex items-center justify-center text-center min-h-screen py-10 px-4 overflow-hidden"
  >
    <!-- Imagen de fondo -->
    <div class="absolute inset-0 fade-in delay-0">
      <img
        src="/assets/hero3.jpg"
        alt="Iglesia Bautista"
        class="w-full h-full object-cover object-top"
      />
      <div class="absolute inset-0 bg-blue-900 bg-opacity-60"></div>
      <!-- Overlay -->
    </div>

    <!-- Contenido encima -->
    <div class="relative z-10 px-4">
      <h1
        class="text-4xl md:text-6xl font-bold text-white mb-6 drop-shadow-lg fade-in delay-0"
      >
        Bienvenido a la Iglesia Bautista de Parla
      </h1>
      <p
        class="text-lg md:text-2xl text-white mb-8 drop-shadow-md fade-in delay-1"
      >
        Un lugar para crecer en fe, verdad y comunidad.
      </p>
      <a
        href="/reuniones"
        class="bg-white text-blue-900 px-6 py-3 rounded-md font-semibold hover:bg-gray-100 transition-all duration-300 fade-in delay-1"
      >
        Planifica tu visita
      </a>
    </div>
  </section>

  <section class="mt-20 text-center">
    <h2 class="text-3xl font-semibold mb-4 text-blue-900">¿Quiénes somos?</h2>
    <p class="max-w-2xl mx-auto text-gray-600 mb-6">
      Somos una comunidad centrada en el Evangelio de Jesucristo, comprometidos
      a predicar la verdad bíblica y a vivir en amor fraternal. Lorem ipsum
      dolor sit amet consectetur, adipisicing elit. Est voluptate facere dolorem
      tempora quidem nobis facilis ipsa, fugit illo quia?
    </p>
    <a href="/quienes-somos" class="text-blue-700 font-medium hover:underline">
      Conócenos mejor →
    </a>
  </section>
</BaseLayout>
