        class="fill-gray-50"></path>
    </svg>
  </div>

  <!-- Sección: Versículo Central -->
  <section class="py-20 bg-white text-center">
    <div class="max-w-4xl mx-auto px-4">
      <blockquote
        class="text-2xl md:text-3xl italic font-semibold text-blue-800 fade-in delay-0"
      >
        "Id por todo el mundo y predicad el Evangelio a toda criatura." <br />
        <span class="text-lg text-gray-600">— Marcos 16:15</span>
      </blockquote>
    </div>
  </section>
</BaseLayout>
