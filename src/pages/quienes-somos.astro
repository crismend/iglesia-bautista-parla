  <!-- Sección: Nuestra Fe -->
  <!-- Sección: Nuestra Fe con efecto stagger -->
  <section class="py-20 bg-gray-50 text-center">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-semibold text-blue-900 mb-8 fade-in delay-0">
        Nuestra Fe
      </h2>
      <ul class="text-lg text-gray-700 space-y-4">
        <li class="fade-in delay-1">
          📖 Creemos en la autoridad suprema de las Escrituras.
        </li>
        <li class="fade-in delay-2">
          ✝️ Creemos en la salvación solo por gracia, por medio de la fe en
          Jesucristo.
        </li>
        <li class="fade-in delay-3">
          🤝 Creemos en la comunidad de los santos como cuerpo de Cristo.
        </li>
        <li class="fade-in delay-4">
          🙌 Creemos en la soberanía de Dios en todas las cosas.
        </li>
      </ul>
    </div>
  </section>

  <div class="wave-divider">
