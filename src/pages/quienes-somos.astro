---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Quiénes Somos - Iglesia Bautista Reformada"
  description="Conoce más sobre nuestra fe, misión y comunidad."
>
  <!-- Sección: Quiénes Somos -->
  <section class="text-center py-20 bg-white">
    <h1
      class="text-4xl md:text-6xl font-bold text-blue-900 mb-6 fade-in delay-0"
    >
      Quiénes Somos
    </h1>
    <p
      class="text-lg md:text-2xl text-gray-600 max-w-3xl mx-auto fade-in delay-1"
    >
